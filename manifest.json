{
  "manifest_version": 3,
  "name": "NextUp – Movies, TV & Anime Releases",
  "description": "Track upcoming & past releases for Movies, TV & Anime.",
  "version": "1.0.1",

  "action": {
    "default_title": "NextUp",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },

  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },

  "permissions": ["storage"],
  "host_permissions": [
    "https://api.themoviedb.org/*",
    "https://graphql.anilist.co/*"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "ujjwalkr80@gmail.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
